local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local TS=game:GetService("TweenService")
local LP=Players.LocalPlayer
local Settings={
Enabled=false,Radius=55,Duration=0.1,Mode="half",FireRange=10,HoldMin=1.3,HoldMax=2.6,EntryDelay=0.3,Data={}
}
local isRunning=false
local startTime=nil
local autoConn=nil
local progressFill,progressPct
local screenGui,mainFrame
local function isOwnPlot(name)
local plots=workspace:FindFirstChild("Plots")
if not plots then return false end
local plot=plots:FindFirstChild(name)
if not plot then return false end
local sign=plot:FindFirstChild("PlotSign")
if sign then
local base=sign:FindFirstChild("YourBase")
if base and base:IsA("BillboardGui") then
return base.Enabled==true
end
end
return false
end
local function getNearestPrompt()
local char=LP.Character
if not char then return nil end
local root=char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
if not root then return nil end
local plots=workspace:FindFirstChild("Plots")
if not plots then return nil end
local nearest,dist=nil,math.huge
for _,plot in ipairs(plots:GetChildren()) do
if plot:IsA("Model") and not isOwnPlot(plot.Name) then
local pods=plot:FindFirstChild("AnimalPodiums")
if pods then
for _,pod in ipairs(pods:GetChildren()) do
local base=pod:FindFirstChild("Base")
local spawn=base and base:FindFirstChild("Spawn")
if spawn then
local d=(spawn.Position-root.Position).Magnitude
if d<=Settings.Radius and d<dist then
local found=nil
local att=spawn:FindFirstChild("PromptAttachment")
if att then
for _,pr in ipairs(att:GetChildren()) do
if pr:IsA("ProximityPrompt") and pr.ActionText and pr.ActionText:find("Steal") then
found=pr
end
end
end
if not found then
for _,pr in ipairs(spawn:GetDescendants()) do
if pr:IsA("ProximityPrompt") and pr.ActionText and pr.ActionText:find("Steal") then
found=pr
end
end
end
if found then nearest,dist=found,d end
end
end
end
end
end
end
return nearest
end
local function getPromptDistance(prompt)
local char=LP.Character
if not char then return math.huge end
local root=char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
if not root then return math.huge end
local part=prompt.Parent
if part and part:IsA("Attachment") then part=part.Parent end
if part and part:IsA("BasePart") then return (part.Position-root.Position).Magnitude end
local ok,cf=pcall(function() return prompt.Parent and prompt.Parent.WorldPosition end)
if ok and cf then return (cf-root.Position).Magnitude end
return math.huge
end
local function runSteal(prompt)
if isRunning then return end
if not Settings.Data[prompt] then
Settings.Data[prompt]={hold={},trigger={},ready=true}
if getconnections then
for _,c in ipairs(getconnections(prompt.PromptButtonHoldBegan)) do
if c.Function then table.insert(Settings.Data[prompt].hold,c.Function) end
end
for _,c in ipairs(getconnections(prompt.Triggered)) do
if c.Function then table.insert(Settings.Data[prompt].trigger,c.Function) end
end
end
end
local data=Settings.Data[prompt]
if not data.ready then return end
data.ready=false
isRunning=true
startTime=tick()
if Settings.Mode=="half" then
task.spawn(function()
for _,fn in ipairs(data.hold) do task.spawn(fn) end
task.wait(Settings.HoldMin)
local inRange=getPromptDistance(prompt)<=Settings.FireRange
while true do
local elapsed=tick()-startTime
if elapsed>Settings.HoldMax or not prompt.Parent then break end
if getPromptDistance(prompt)<=Settings.FireRange then
if not inRange then task.wait(Settings.EntryDelay) end
for _,fn in ipairs(data.trigger) do task.spawn(fn) end
break
end
task.wait()
end
task.wait(0.05)
data.ready=true
isRunning=false
end)
else
task.spawn(function()
for _,fn in ipairs(data.hold) do task.spawn(fn) end
local elapsed=0
while elapsed<Settings.Duration do
elapsed=elapsed+task.wait()
end
for _,fn in ipairs(data.trigger) do task.spawn(fn) end
task.wait(0.05)
data.ready=true
isRunning=false
end)
end
end
local function startAuto()
if autoConn then return end
autoConn=RunService.Heartbeat:Connect(function()
if not Settings.Enabled or isRunning then return end
local p=getNearestPrompt()
if p then runSteal(p) end
end)
end
local function stopAuto()
if autoConn then
autoConn:Disconnect()
autoConn=nil
end
isRunning=false
end
local function createMenu()
if screenGui then return end
local oldGUI=LP.PlayerGui:FindFirstChild("StealProgressScreenGui")
if oldGUI then oldGUI:Destroy() end
screenGui=Instance.new("ScreenGui")
screenGui.Name="StealProgressScreenGui"
screenGui.ResetOnSpawn=false
screenGui.DisplayOrder=200
screenGui.IgnoreGuiInset=true
screenGui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
screenGui.Parent=LP.PlayerGui
mainFrame=Instance.new("Frame",screenGui)
mainFrame.Name="StealProgressGui"
mainFrame.Size=UDim2.new(0,200,0,22)
mainFrame.Position=UDim2.new(0.5,0,1,-72)
mainFrame.AnchorPoint=Vector2.new(0.5,1)
mainFrame.BackgroundColor3=Color3.fromRGB(20,20,25)
mainFrame.BackgroundTransparency=0.2
mainFrame.BorderSizePixel=0
mainFrame.Active=true
mainFrame.Visible=true
mainFrame.ZIndex=300
mainFrame.ClipsDescendants=true
Instance.new("UICorner",mainFrame).CornerRadius=UDim.new(0,10)
local fill=Instance.new("Frame",mainFrame)
fill.Name="ProgressFill"
fill.Size=UDim2.new(0,0,1,0)
fill.Position=UDim2.new(0,0,0,0)
fill.BackgroundColor3=Color3.fromRGB(220,40,40)
fill.BackgroundTransparency=0
fill.BorderSizePixel=0
fill.ZIndex=301
fill.ClipsDescendants=true
local fillCorner=Instance.new("UICorner",fill)
fillCorner.CornerRadius=UDim.new(0,10)
local border=Instance.new("UIStroke",mainFrame)
border.Color=Color3.fromRGB(255,255,255)
border.Thickness=0.5
border.Transparency=0.3
border.ApplyStrokeMode=Enum.ApplyStrokeMode.Border
local pctLabel=Instance.new("TextLabel",mainFrame)
pctLabel.Size=UDim2.new(1,0,1,0)
pctLabel.Position=UDim2.new(0,0,0,0)
pctLabel.BackgroundTransparency=1
pctLabel.Text="AUTO STEAL UNREADY"
pctLabel.TextColor3=Color3.fromRGB(255,255,255)
pctLabel.Font=Enum.Font.GothamBold
pctLabel.TextSize=9
pctLabel.TextStrokeTransparency=0.7
pctLabel.TextStrokeColor3=Color3.fromRGB(0,0,0)
pctLabel.TextXAlignment=Enum.TextXAlignment.Center
pctLabel.TextYAlignment=Enum.TextYAlignment.Center
pctLabel.ZIndex=304
progressFill=fill
progressPct=pctLabel
local FILL_DURATION=0.1
local lastPct=0
RunService.RenderStepped:Connect(function()
if not mainFrame or not mainFrame.Visible then return end
local pct=0
if isRunning and startTime then
pct=math.clamp((tick()-startTime)/FILL_DURATION,0,1)
elseif Settings.Enabled then
pct=(getNearestPrompt() and 1 or 0)
end
lastPct=lastPct+(pct-lastPct)*0.2
local f=math.clamp(lastPct,0,1)
if progressFill then
progressFill.Size=UDim2.new(f,0,1,0)
end
if progressPct then
if lastPct>=0.87 then
progressPct.Text="AUTO STEAL READY"
progressPct.TextColor3=Color3.fromRGB(120,255,120)
else
progressPct.Text="AUTO STEAL UNREADY"
progressPct.TextColor3=Color3.fromRGB(255,255,255)
end
end
end)
end
local function destroyMenu()
if screenGui then
screenGui:Destroy()
screenGui=nil
mainFrame=nil
progressFill=nil
progressPct=nil
end
end
function _G.StartScript()
createMenu()
Settings.Enabled=true
pcall(startAuto)
end
function _G.StopScript()
destroyMenu()
stopAuto()
Settings.Enabled=false
end
_G.StartScript()
